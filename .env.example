DATABASE_URL=sqlite:///./careweave.db
PYTHON_VERSION=3.11.11
# With Render Root Directory=backend, this tracked deployment model resolves here.
MODEL_PATH=backend/models/fabric_mobilenetv2.pt
CORS_ORIGINS=http://localhost:5173
# Firebase Authentication (Web app settings from Firebase Console)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_URL=
# Backend-only: a Firebase service-account JSON file. Do not commit this file.
FIREBASE_SERVICE_ACCOUNT_FILE=
# AWS ECS/Elastic Beanstalk alternative: inject the full JSON as a Secrets Manager value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated app-administrator emails. Keep this server-side only.
ADMIN_EMAILS=
# Disabled by default on web hosts. Train offline/on a GPU worker, review metrics,
# then promote a candidate model through deployment.
ENABLE_RETRAINING=false
# Use `firebase` on Render after Realtime Database and Storage are ready.
# Keep `local` for development and automated tests.
PERSISTENCE_BACKEND=local

# Vercel frontend-only Firebase sign-in (these values are public web config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
